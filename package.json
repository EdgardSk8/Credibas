{
  "name": "credibas",
  "version": "0.1.0",
  "private": true,
  "description": "Credibas - Plataforma SaaS de gestion de creditos, cartera y cobros",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:version": "npm run build && wrangler versions upload",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply credibas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply credibas-db --remote",
    "db:seed:local": "wrangler d1 execute credibas-db --local --file=./seeds/dev.sql",
    "db:seed:demo": "wrangler d1 execute credibas-db --local --file=./seeds/demo.sql",
    "db:seed:build": "node scripts/generate-demo-seed.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@tanstack/react-query": "^5.108.2",
    "decimal.js": "^10.6.0",
    "hono": "^4.13.19",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  }
}
