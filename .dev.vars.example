# Copia este archivo como .dev.vars para desarrollo local.
# .dev.vars está ignorado por git.

APP_ENV=development
APP_URL=http://localhost:5173
APP_NAME=Credibas
EMAIL_PROVIDER=console
PAYMENTS_PROVIDER=manual

# Iteraciones PBKDF2. 100000 es el valor recomendado; puedes bajarlo en local.
PASSWORD_ITERATIONS=100000

# Turnstile (obligatorio en producción)
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Correo transaccional (si EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=no-reply@credibas.app
# EMAIL_FROM_NAME=Credibas

# Relay propio (Apps Script + Gmail), ver docs/EMAIL-RELAY.md
# MAIL_RELAY_URL=https://script.google.com/macros/s/XXXX/exec
# MAIL_RELAY_SECRET=secreto-de-32-o-mas-caracteres
# EMAIL_FROM_NAME=tellezsoftware

# Webhook de facturación
# BILLING_WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo

# LAFISE (cobro automático con tarjeta). Sin credenciales el motor emite
# factura y aviso, pero no cobra. Ver docs/PAGOS-LAFISE.md
# PAYMENTS_PROVIDER=lafise
# LAFISE_API_BASE=
# LAFISE_MERCHANT_ID=
# LAFISE_API_KEY=
# LAFISE_WEBHOOK_SECRET=
